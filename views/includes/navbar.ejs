<style>
/* ===== Desktop Styles ===== */
.search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    display: flex;
    align-items: center;
    cursor: pointer;
}

.search-btn:hover {
    background-color: #fe424d;
    color: #fff;
}

.search-btn i {
    margin-right: 0.45rem;
}

.search-inp {
    border-radius: 25px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    width: 100%; /* fill parent container */
    box-sizing: border-box; /* padding included in width */
}

/* Center the search form */
.navbar-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 400px; /* desktop width */
}

/* ===== Mobile Responsive ===== */
@media (max-width: 768px) {
    .navbar-center {
        position: relative;      /* absolute se relative */
        left: 0;
        transform: none;
        width: 90%;              /* responsive width */
        max-width: 350px;
        margin: 0 auto;          /* center horizontally */
        display: flex;
        flex-direction: column;  /* vertical stack */
        align-items: center;
    }

    .search-inp {
        width: 100%;             /* fill parent */
        margin-bottom: 0.5rem;   /* spacing between input & button */
    }

    .search-btn {
        width: 100%;             /* full width */
        justify-content: center; /* icon + text centered */
        margin: 0;
    }
}
</style>

<nav class="navbar navbar-expand-md bg-light border-bottom sticky-top">
  <div class="container-fluid">

    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>
    <div class="navbar-nav">
      <a class="nav-link" href="/listings">Explore</a>
    </div>

    <form class="d-flex navbar-center" role="search">
      <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations" />
      <button class="btn search-btn" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>Search
      </button>
    </form>
    <div class="navbar-nav ms-auto d-flex align-items-center gap-3">
      <a class="nav-link" href="/listings/new">Airbnb your home</a>

      <% if(!currUser) { %>
        <a class="nav-link" href="/users/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/users/login"><b>Log in</b></a>
      <% } else { %>
        <a class="nav-link" href="/users/logout"><b>Log out</b></a>
      <% } %>
    </div>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
  </div>
</nav>
