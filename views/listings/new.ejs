<%- layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br><br>
            <h3>Create New Listings</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <lable for="title" class="form-lable">Title</lable>
                    <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control"
                        required />

                    <div class="valid-feedback"> Title is good</div>

                </div>


                <div class="mb-3">
                    <lable for="description" class="form-label">Description</lable>
                    <textarea name="listing[description]" type="text" class="form-control" required></textarea>
                    <div class="invalid-feedback"> Please enter a short description</div>
                </div>
                
                <div class="mb-3">
                    <lable for="image" class="form-label">Upload Listing image</lable>
                    <input name="listing[image]"type="file" class="form-control" />
                    required
                </div>

                <div class="mb-3">
                    <lable for="price" class="form-label">Price</lable>
                    <input name="listing[price]" placeholder="000" type="number" class="form-control" required />
                    <div class="invalid-feedback"> Price should be valid</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <lable for="country" class="form-label">Country</lable>
                        <input name="listing[country]" placeholder="Country" type="text" class="form-control" required />
                        <div class="invalid-feedback"> Country name should be valid</div>


                    </div>
                    <div class="mb-3 col-md-8">
                        <lable for="location" class="form-label">Location</lable>
                        <input name="listing[location]" placeholder="Address" type="text" class="form-control"
                            required />
                        <div class="invalid-feedback"> Location should be valid</div>
                    </div>
                </div>

                <button class="btn btn-dark add-btn mt-3">Add</button>
                <br><br>
            </form>
        </div>
    </div>
